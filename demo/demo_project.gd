static func create() -> Dictionary:
	return JSON.parse_string(DEMO_JSON)

static func build_sandbox() -> Dictionary:
	return JSON.parse_string(SANDBOX_JSON)

static func ensure_project_file(path: String, sandbox: bool = false) -> Error:
	if FileAccess.file_exists(path):
		return OK
	var file = FileAccess.open(path, FileAccess.WRITE)
	if file == null:
		return FileAccess.get_open_error()
	file.store_string(JSON.stringify(build_sandbox() if sandbox else create(), "  "))
	file.close()
	print("Dirge demo: generated " + path)
	return OK

