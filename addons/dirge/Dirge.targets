<Project>
  <!-- Import once from the host Godot project's .csproj:
       <Import Project="addons/dirge/Dirge.targets" /> -->
  <PropertyGroup>
    <DirgeDirectory>$(MSBuildThisFileDirectory)</DirgeDirectory>
  </PropertyGroup>
  <ItemGroup>
    <!-- The engine-independent model builds as its own assembly; runtime/ compiles into the host project. -->
    <Compile Remove="$(DirgeDirectory)model/**" />
    <ProjectReference Include="$(DirgeDirectory)model/Dirge.Model.csproj" />
  </ItemGroup>
</Project>
