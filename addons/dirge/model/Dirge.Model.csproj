<Project Sdk="Microsoft.NET.Sdk">
  <!-- Engine-independent adaptive-audio model: project graph, parameters, instances, scheduler, mixer evaluation,
       serialization and validation. Must not reference Godot. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Dirge</RootNamespace>
    <AssemblyName>Dirge.Model</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Dirge.Model.Tests" />
  </ItemGroup>
</Project>
