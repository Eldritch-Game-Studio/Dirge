extends RefCounted
const Document = preload("res://addons/dirge/tool/Core/project_document.gd")
const Mixer = preload("res://addons/dirge/tool/Mixer/mixer_pane.gd")
const Ops = preload("res://addons/dirge/tool/Mixer/mixer_graph_ops.gd")
const Catalog = preload("res://addons/dirge/tool/Mixer/effect_catalog.gd")
const Timeline = preload("res://addons/dirge/tool/Profiler/recording_canvas.gd")
const Graph = preload("res://addons/dirge/tool/Profiler/update_graph.gd")
const Profiler = preload("res://addons/dirge/tool/Profiler/profiler_pane.gd")

func run(test: Object) -> void:
	var document = Document.new()
	var pane = Mixer.new()
	pane.setup(document)
	var master = Ops.master(document.project.mixer).id
	var music = pane.add_bus(master)
	var child = pane.add_bus(music)
	test.check(Ops.find_bus(document.project.mixer, child).parent == music, "Mixer adds selected child bus")
	test.check(Ops.find_bus(document.project.mixer, child).name == "Bus 2", "Mixer names buses uniquely")
	pane.set_bus_parent(music, child)
	test.check(Ops.find_bus(document.project.mixer, music).parent == master, "Mixer rejects routing cycles")
	pane.set_bus_parent(master, child)
	test.check(Ops.master(document.project.mixer).id == master, "Master cannot be rerouted")
	pane.rename_bus(music, "Music")
	pane.set_bus_property(music, "mute", true)
	pane.set_bus_property(music, "solo", true)
	pane.set_bus_property(music, "bypassEffects", true)
	pane.set_bus_property(music, "maxVoices", 12)
	test.check(Ops.find_bus(document.project.mixer, music).mute and Ops.find_bus(document.project.mixer, music).solo and Ops.find_bus(document.project.mixer, music).bypassEffects, "Mute solo bypass authored independently")
	pane.set_bus_property(music, "volumeDb", -9.0)
	var snapshot = pane.add_snapshot()
	pane.set_bus_property(music, "volumeDb", -24.0)
	var target = Ops.property("BusVolumeDb", music)
	test.check(Ops.find_bus(document.project.mixer, music).volumeDb == -9.0, "Snapshot fader does not change authored bus volume")
	test.check(Ops.find_value(Ops.find(document.project.snapshots, snapshot), target).value == -24.0, "Snapshot fader scopes property on touch")
	pane.capture_snapshot()
	test.check(Ops.find_value(Ops.find(document.project.snapshots, snapshot), target).value == -24.0, "Capture preserves already scoped mix values")
	test.check(Ops.find(document.project.snapshots, snapshot).values.size() == 3, "Capture scopes every bus")
	pane.unscope(target)
	test.check(Ops.find_value(Ops.find(document.project.snapshots, snapshot), target).is_empty(), "Unscope removes only targeted snapshot property")
	document.undo()
	test.check(Ops.find_value(Ops.find(document.project.snapshots, snapshot), target).value == -24.0, "Undo restores snapshot scope and exact value")
	pane.set_snapshot_property(snapshot, "mode", "Overriding")
	pane.set_snapshot_property(snapshot, "priority", 4)
	pane.set_snapshot_envelope("attack", 0.25)
	pane.set_snapshot_envelope("sustain", 2.0)
	test.check(Ops.find(document.project.snapshots, snapshot).intensity.sustain == 1.0, "Snapshot sustain clamps to unit range")
	pane.select_snapshot("")
	var vca = pane.add_vca()
	pane.toggle_vca_assignment(music, vca)
	pane.set_vca_property(vca, "volumeDb", -3.0)
	test.check(Ops.find_bus(document.project.mixer, music).vcas.has(vca), "VCA assignment authors membership")
	pane.delete_vca(vca)
	test.check(not Ops.find_bus(document.project.mixer, music).vcas.has(vca), "VCA deletion removes memberships")
	document.undo()
	test.check(Ops.find_bus(document.project.mixer, music).vcas.has(vca), "VCA deletion undo restores memberships")
	var compressor = pane.add_ducking(music, "Dialogue")
	var effect = Ops.find(Ops.find_bus(document.project.mixer, music).effects, compressor)
	test.check(effect.parameters.threshold == -24.0 and effect.parameters.ratio == 8.0 and effect.parameters.attack_us == 20000.0 and effect.parameters.release_ms == 250.0 and effect.stringParameters.sidechain == "Dialogue", "Ducking preset retains exact compressor units and defaults")
	test.check(Catalog.display_name(effect) == "Ducking (from Dialogue)", "Sidechain compressor gets ducking display name")
	var second = pane.add_effect(music, "AudioEffectLowPassFilter")
	pane.select_snapshot(snapshot)
	pane.set_effect_parameter(music, compressor, "threshold", -32.0)
	pane.move_chain_row(music, 0, 2)
	var bus = Ops.find_bus(document.project.mixer, music)
	test.check(bus.effects[0].id == second and bus.effects[1].id == compressor and bus.faderIndex == 1, "Effect drag crosses fader while preserving authored chain indices")
	var scoped = Ops.find_value(Ops.find(document.project.snapshots, snapshot), Ops.property("EffectParameter", music, 1, "threshold"))
	test.check(scoped.get("value") == -32.0, "Effect drag remaps scoped snapshot address")
	pane.move_chain_row(music, 1, 2)
	test.check(Ops.find_bus(document.project.mixer, music).faderIndex == Ops.AFTER_ALL, "Moving fader after all effects restores sentinel")
	pane.remove_effect(music, second)
	test.check(Ops.find_value(Ops.find(document.project.snapshots, snapshot), Ops.property("EffectParameter", music, 0, "threshold")).get("value") == -32.0, "Effect removal shifts scoped indices")
	document.undo()
	test.check(Ops.find_bus(document.project.mixer, music).effects.size() == 2, "Effect deletion undo restores entire chain")
	pane.select_snapshot("")
	pane.set_effect_parameter(music, compressor, "sidechain", "Speech")
	test.check(Ops.find(Ops.find_bus(document.project.mixer, music).effects, compressor).stringParameters.sidechain == "Speech", "String DSP properties remain separate from numeric values")
	var lfo = pane.add_lfo(music)
	pane.set_lfo_property(lfo, "shape", "SawDown")
	pane.set_lfo_property(lfo, "rateHz", 40.0)
	pane.set_lfo_property(lfo, "amount", 6.0)
	var modulator = Ops.find(document.project.mixerModulators, lfo)
	test.check(modulator.get("$type") == "Lfo" and modulator.shape == "SawDown" and modulator.rateHz == 20.0 and modulator.amount == 6.0, "LFO preserves JSON discriminator, waveform and constrained controls")
	var parameter = Ops.new_id()
	document.project.globalParameters.append({"id": parameter, "name": "Intensity", "minimum": 0.0, "maximum": 1.0})
	var lane = pane.automation.add_lane(Ops.property("EffectParameter", music, 1, "threshold"), parameter)
	pane.automation.set_points(lane, [{"x": 1.0, "y": -12.0, "shapeToNext": "Stepped"}, {"x": 0.0, "y": -24.0, "shapeToNext": "Smooth"}])
	test.check(Ops.find(document.project.mixerAutomation, lane).curve.points[0].shapeToNext == "Smooth", "Automation points sorted while preserving curve shapes")
	pane.move_chain_row(music, 1, 0)
	test.check(Ops.find(document.project.mixerAutomation, lane).target.effectIndex == 0, "Effect movement remaps mixer automation addresses")
	document.project.events.append({"id": Ops.new_id(), "path": "Music/Test", "bus": music})
	pane.delete_bus(music)
	test.check(Ops.find_bus(document.project.mixer, child).parent == master and document.project.events.back().bus == master, "Bus deletion reroutes children and events")
	test.check(Ops.find(document.project.mixerModulators, lfo).is_empty() and Ops.find(document.project.mixerAutomation, lane).is_empty(), "Bus deletion removes dangling modulation and automation")
	document.undo()
	test.check(not Ops.find_bus(document.project.mixer, music).is_empty() and Ops.find_bus(document.project.mixer, child).parent == music, "Bus deletion undo restores hierarchy")
	pane.delete_bus(master)
	test.check(Ops.master(document.project.mixer).id == master, "Master deletion rejected")
	pane.free()
	_test_timeline(test)
	_test_catalog(test)

func _test_timeline(test: Object) -> void:
	var recording = {"ticks": [
		{"time": 0.0, "dt": 0.1, "calls": [{"method": "CreateInstance", "result": 2, "name": "Music/Test"}, {"method": "Start", "handle": 2}], "ended": []},
		{"time": 0.1, "dt": 0.2, "calls": [{"method": "Stop", "handle": 2, "mode": 0}], "ended": [2]},
		{"time": 0.3, "dt": 0.1, "calls": [{"method": "Start", "handle": 2}], "ended": []}]}
	var timeline = Timeline.new()
	timeline.size = Vector2(640, 200)
	timeline.set_recording(recording, "Regression recording")
	test.check(timeline.bars.size() == 2 and is_equal_approx(timeline.length, 0.4), "Recording timeline builds every lifetime including restart")
	test.check(not timeline.bars[0].openEnd and timeline.bars[1].openEnd, "Timeline distinguishes ended and open lifetimes")
	test.check(is_equal_approx(timeline.bars[0].stopAt, 0.1) and timeline.bars[0].row == timeline.bars[1].row, "Timeline marks fade tail and reuses handle rows")
	var hit = timeline.hit_test(Vector2(timeline.time_to_x(0.05), timeline.row_to_y(0) + 2))
	test.check(hit == 0, "Recording bars provide precise hit testing")
	timeline.set_divergence(0.1)
	timeline.select_handle(2)
	test.check(timeline.selected_handle == 2 and timeline.divergence_time == 0.1, "Timeline tracks selection and first-divergence marker")
	timeline.free()
	var graph = Graph.new()
	for i in range(4200): graph.push(i / 100.0, 0.5, 8)
	test.check(graph.sample_count == 4096, "Profiler graph uses bounded ring buffer")
	graph.voice_capacity = 64
	test.check(graph.scales().y >= 64 and graph.scales().x >= 0.5, "Profiler axes honor voice budget and update scale")
	graph.clear()
	test.check(graph.sample_count == 0, "Profiler source switch can clear rolling graph")
	graph.free()
	test.check(Profiler.format_loudness(-INF) == "silent" and Profiler.format_loudness(NAN) == "—", "Loudness distinguishes silence from unavailable meter")
	test.check(is_equal_approx(Profiler.duration(recording), 0.4), "Profiler recording duration includes final delta")

func _test_catalog(test: Object) -> void:
	var types = Catalog.available_types()
	test.check(types.has("AudioEffectCompressor") and types.has("AudioEffectLowPassFilter"), "Catalog discovers instantiable built-in effects")
	test.check(not types.has("AudioEffectCapture") and not types.has("AudioEffectRecord"), "Catalog omits instrumentation-only effects")
	var sidechain = false
	for property in Catalog.parameters("AudioEffectCompressor"):
		if property.name == "sidechain": sidechain = property.kind == "String"
	test.check(sidechain, "Catalog reflects string sidechain property")
	var cutoff = false
	for property in Catalog.parameters("AudioEffectLowPassFilter"):
		if property.name == "cutoff_hz": cutoff = property.max > property.min
	test.check(cutoff, "Catalog reflects inherited filter parameters")
	for native in Catalog.NATIVE_TYPES:
		if ClassDB.class_exists(native): test.check(types.has(native), "Catalog includes native DSP " + native)
