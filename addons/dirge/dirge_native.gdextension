[configuration]

entry_symbol = "dirge_native_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]

linux.debug.x86_64 = "res://addons/dirge/bin/linux-x64/libdirge_native.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/dirge/bin/linux-x64/libdirge_native.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://addons/dirge/bin/windows-x64/libdirge_native.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/dirge/bin/windows-x64/libdirge_native.windows.template_release.x86_64.dll"
macos.debug = "res://addons/dirge/bin/macos/libdirge_native.macos.template_debug.framework"
macos.release = "res://addons/dirge/bin/macos/libdirge_native.macos.template_release.framework"
