<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>DirgeDemo</RootNamespace>
    <DefaultItemExcludes>$(DefaultItemExcludes);.godot/**;proof/**;proof-*/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**;tools/**;native/**;proof/**;proof-*/**" />
  </ItemGroup>
  <Import Project="addons/necronomidom/NecronomiDom.targets" />
  <Import Project="addons/dirge/Dirge.targets" />
</Project>
